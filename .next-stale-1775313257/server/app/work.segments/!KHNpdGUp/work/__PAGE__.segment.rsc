0:{"rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen bg-bg-deep pt-32 md:pt-40","children":[["$","section",null,{"className":"mx-auto max-w-[1200px]","data-concierge-section":"work-hero","data-concierge-label":"Work Overview","children":["$","div",null,{"className":"px-6 md:px-12","children":[["$","span",null,{"className":"font-mono text-xs uppercase tracking-[0.2em] text-accent","children":"Work"}],["$","h1",null,{"className":"mt-5 max-w-4xl font-heading text-[clamp(2.75rem,6vw,5.5rem)] font-bold leading-[0.98] text-text-primary","children":"Proof-first case studies for teams who need the work to sell before the meeting is over."}],["$","p",null,{"className":"mt-6 max-w-3xl text-lg leading-relaxed text-text-secondary","children":"Each case study is built to show the strategic turn, the execution discipline, and the outcome that made the work matter. Start anywhere. The thread is the same."}]]}]}],["$","$L2",null,{"panels":[{"id":"orangetheory-fitness","number":"01","title":"Orangetheory Fitness","tagline":"Everyone said they didn’t have time. So we stopped selling workouts.","description":"Everyone said they didn’t have time. So we stopped selling workouts and started giving people permission to take one hour back. 3.75B impressions. 40%+ aided awareness.","sector":"Fitness","tags":["Positioning","Campaign Platform","Film","Social"],"stats":[{"label":"Impressions","value":"3.75B"},{"label":"Aided Awareness","value":"40%+"}],"videoSrc":"https://videos.noahisdabomb.com/orangetheory_25hour.mp4","href":"/work/orangetheory-fitness"},{"id":"gila-river","number":"02","title":"Gila River Resorts & Casinos","tagline":"Casinos talk to gamblers. We talked to everyone else.","description":"“You Do You” gave the brand permission to be inclusive without ever saying the word. Four campaign chapters, custom animation, and a platform that kept skewing younger every quarter.","sector":"Resorts & Casinos","tags":["Brand Strategy","Campaign Development","Film","Social"],"stats":[{"label":"Campaign Chapters","value":"4"},{"label":"Expansion Value","value":"$$750M"},{"label":"New Property Launch","value":"$$180M"},{"label":"The Whole Point","value":"You"}],"videoSrc":"https://videos.noahisdabomb.com/gila_river_you_do_you.mp4","href":"/work/gila-river"},{"id":"coca-cola","number":"03","title":"Coca-Cola","tagline":"From a film about first dates to running social for the most recognized brand on earth.","description":"A short film about first dates at the movies. Then a 55-person real-time newsroom across Coke, Diet Coke, Fanta, and Sprite. Two chapters, same lesson: the brand isn’t the story.","sector":"Beverage","tags":["Film","Social Systems","Creative Direction","Editorial"],"stats":[{"label":"Platforms","value":"5"},{"label":"Brands","value":"4"},{"label":"Person Newsroom","value":"55"}],"videoSrc":"https://videos.noahisdabomb.com/coke_date_night_cover_v1.mp4","href":"/work/coca-cola"},{"id":"visit-the-usa","number":"04","title":"Visit The USA","tagline":"Everyone thinks they’ve already seen America. We proved them wrong.","description":"More to Discover used split-screen contrasts to pair the iconic with the unexpected, transcreated across 13+ languages without ever feeling diluted.","sector":"Tourism","tags":["Integrated","Film","Social","OOH","Digital","Transcreation"],"stats":[{"label":"Languages","value":"13+"},{"label":"Assets Produced","value":"100+"},{"label":"Team Directed","value":"15"},{"label":"Markets Reached","value":"30+"}],"videoSrc":"https://videos.noahisdabomb.com/visitusa_hero.mp4","href":"/work/visit-the-usa"},{"id":"toyota","number":"05","title":"Toyota","tagline":"381 horses under the hood. Zero limits on how we told the story.","description":"We stopped apologizing for where the Tundra was built and started showing what it could do. Then extended that confidence across the whole lineup with “Go Anywhere, Imagine Everything.”","sector":"Automotive","tags":["Campaign Development","Film","Digital","Social"],"stats":[{"label":"Vehicle Lines","value":"3"},{"label":"Campaign Platforms","value":"Film + Digital + Social"}],"videoSrc":"https://videos.noahisdabomb.com/toyota_tundra.mp4","href":"/work/toyota"},{"id":"delta-air-lines","number":"06","title":"Delta Air Lines","tagline":"We took Delta’s most iconic symbol off the plane and rolled it into the streets.","description":"We took the beverage cart off the plane and rolled it into five cities. Real pilots, real flight attendants, Biscoff cookies, and in-flight items turned into percussion instruments. 98% positive sentiment. Zero paid push.","sector":"Travel","tags":["Experiential","Campaign Development","Film","Social"],"stats":[{"label":"Positive Sentiment","value":"98%"},{"label":"Cities Activated","value":"5"},{"label":"New Social Followers","value":"141K"},{"label":"Hashtag Adoption","value":"84%"}],"videoSrc":"https://videos.noahisdabomb.com/starbucks_%23cheercart.mp4","href":"/work/delta-air-lines"},{"id":"visit-lauderdale","number":"07","title":"Visit Lauderdale","tagline":"We won the account in August. Moved the entire world by November. Then earned the right to reposition the whole brand.","description":"Break Free launched a winter campaign with 3D billboards and heated pop-ups that made people physically feel warmth. Then Never Lose Your Splash repositioned the entire destination around the one asset nobody else could claim.","sector":"Tourism","tags":["Brand Platform","Film","3D OOH","Experiential","Social","Digital"],"stats":[{"label":"Likelihood to Visit","value":"2.5x"},{"label":"Brand Love Increase","value":"85%"},{"label":"Visitation Lift","value":"152%"},{"label":"Category of One","value":"Water"}],"href":"/work/visit-lauderdale"},{"id":"orangetheory-more-life","number":"08","title":"Orangetheory More Life","tagline":"The fitness category was obsessed with muscles. We made the entire world care about the one that actually matters.","description":"More Life shifted Orangetheory from workout brand to lifestyle platform by building every message around the heart — the muscle that keeps you alive — instead of the ones you see in the mirror.","sector":"Fitness","tags":["Brand Platform","Film","Broadcast","OOH","Social","Digital"],"stats":[{"label":"Studios Worldwide","value":"1,300+"},{"label":"Systemwide Sales","value":"$$1B"},{"label":"Lead Increase","value":"67%"},{"label":"Consecutive Growth","value":"5 Yrs"}],"href":"/work/orangetheory-more-life"}],"sectors":["Fitness","Resorts & Casinos","Beverage","Tourism","Automotive","Travel"]}],"$L3"]}],["$L4"],"$L5"]}],"isPartial":false,"staleTime":300,"varyParams":null,"buildId":"XZvsgOZMlT5lBzuq4oRzT"}
